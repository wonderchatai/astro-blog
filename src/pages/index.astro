---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
---

<Layout title="Wonder Blog - Home">
  <main>
    <h1>Welcome to the Wonder Blog!</h1>
    <p>A place for all things wonder.</p>

    <section>
      <h2>Latest Posts</h2>
      {
        allBlogPosts.map((post) => (
          <article>
            <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <p><small>Published on: {post.data.pubDate}</small></p>
            {post.data.tags && (
              <p>Tags: {post.data.tags.map(tag => `#${tag}`).join(', ')}</p>
            )}
          </article>
        ))
      }
    </section>
  </main>
</Layout>
