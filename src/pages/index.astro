---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
---

<Layout title="Wonder Blog - Home">
  <main class="container mx-auto mt-8 px-4">
    <h1 class="text-5xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600">Welcome to the Wonder Blog!</h1>
    <p class="text-xl text-gray-300 mb-8">A place for all things wonder, powered by Astro and WonderChat AI.</p>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <h2 class="text-4xl font-semibold mb-6 col-span-full">Latest Posts</h2>
      {
        allBlogPosts.map((post) => (
          <article class="bg-gray-800 p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
            <h3 class="text-2xl font-semibold mb-2"><a href={`/blog/${post.slug}`} class="text-blue-400 hover:text-blue-300 transition-colors duration-200">{post.data.title}</a></h3>
            <p class="text-gray-400 mb-4">{post.data.description}</p>
            <p class="text-gray-500 text-sm mb-2"><small>Published on: {post.data.pubDate}</small></p>
            {post.data.tags && (
              <p class="text-gray-500 text-sm">Tags: {post.data.tags.map(tag => 
                <span class="inline-block bg-gray-700 rounded-full px-3 py-1 text-sm font-semibold text-gray-300 mr-2 mb-2">#{tag}</span>
              )}</p>
            )}
          </article>
        ))
      }
    </section>
  </main>
</Layout>
